Bash-script to start instances based on tag:
============================================
instance_ids=$(aws ec2 describe-instances  --filters "Name=tag:project,Values=labtest"    --query "Reservations[*].Instances[?State.Name=='stopped'].InstanceId" --output text)

if [ -z "$instance_ids" ]; then
  echo "No stopped instances found with tag role:bastion1"
else
  echo "Starting instances: $instance_ids"
  aws ec2 start-instances --instance-ids $instance_ids
fi


#SSH to multiple servers and copy files and run;Make servers.txt has list of servers
cat servers.txt | xargs -I {} bash -c 'scp -i ~/.ssh/id_rsa script.sh ec2-user@{}:/tmp && ssh -i ~/.ssh/id_rsa ec2-user@{} "bash /tmp/script.sh"'
#Restrict to 5 jobs in parallel
cat servers.txt | xargs -P 5 -I {} ssh -i ~/.ssh/id_rsa ec2-user@{} 'bash -s' < script.sh
#ssh to multiple servers using password
cat servers.txt | xargs -I {} ssh user@{} 'bash -s' < script.sh
#ssh to copy and run script
cat servers.txt | xargs -I {} bash -c 'scp script.sh user@{}:/tmp && ssh user@{} "bash /tmp/script.sh"'

