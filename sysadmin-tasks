# Use ARG for Node.js version
ARG NODE_VERSION=18
ARG PYTHON_VERSION=3.9
ARG APP_ENV=development
ARG BUILD_DATE
ARG CUSTOM_MESSAGE="Hello from Docker!"
FROM node:${NODE_VERSION}-alpine AS builder

ENV APP_DIR=/app
ENV DB_HOST=localhost
ENV DB_NAME=test_db

ENV DB_USER=app_user
ENV TABLE_NAME=my_app_data

WORKDIR ${APP_DIR}

COPY package*.json ./
RUN npm install --production

COPY . .

# Final stage
FROM node:${NODE_VERSION}-alpine

WORKDIR ${APP_DIR}

COPY --from=builder ${APP_DIR} .

CMD ["node", "app.js"]

